RewriteEngine On
RewriteBase /

# --- Block known aggressive/non-compliant scraper bots (robots.txt is honor-system only) ---
RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|SemrushBot|MJ12bot|DotBot|PetalBot|BLEXBot|MauiBot|SeekportBot|DataForSeoBot) [NC]
RewriteRule ^ - [F,L]

# --- Redirect old .php URLs to clean URLs (SEO/bookmarks) ---
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^index\.php$ /home [R=301,L]

RewriteCond %{THE_REQUEST} \s/+(about|services|portfolio|contact)\.php[\s?] [NC]
RewriteRule ^(about|services|portfolio|contact)\.php$ /$1 [R=301,L,QSA]

# --- Internally serve the .php file behind each clean URL ---
RewriteRule ^home/?$ index.php [L]
RewriteRule ^(about|services|portfolio|contact)/?$ $1.php [L,QSA]

<Files ".env">
  Deny from all
</Files>

<Files ".gitignore">
  Deny from all
</Files>

<Files "README.md">
  Deny from all
</Files>

<Files "CLAUDE.md">
  Deny from all
</Files>

<Files ".git/">
  Deny from all
</Files>

AddOutputFilterByType DEFLATE text/text text/html text/plain text/xml text/css application/x-javascript application/javascript

